### **5. Practice Problems**

#### **A. Two Sum (Easy)**
- **Problem**: Given an array of integers, return indices of the two numbers such that they add up to a specific target.
- **Key Concept**: Use a hashmap to store and look up differences.

```js
function twoSum(nums, target) {
    const map = new Map();
    for (let i = 0; i < nums.length; i++) {
        let diff = target - nums[i];
        if (map.has(diff)) {
            return [map.get(diff), i];
        }
        map.set(nums[i], i);
    }
    return [];
}
```

#### **B. Maximum Subarray (Medium)**
- **Problem**: Find the contiguous subarray with the largest sum.
- **Key Concept**: Kadane’s Algorithm.
  
```js
function maxSubArray(nums) {
    let maxSoFar = nums[0];
    let maxEndingHere = nums[0];
  
    for (let i = 1; i < nums.length; i++) {
        maxEndingHere = Math.max(nums[i], maxEndingHere + nums[i]);
        maxSoFar = Math.max(maxSoFar, maxEndingHere);
    }
  
    return maxSoFar;
}
```

#### **C. Merge Intervals (Medium)**
- **Problem**: Given a collection of intervals, merge all overlapping intervals.
- **Key Concept**: Sort intervals and merge overlapping ones.

```js
function mergeIntervals(intervals) {
    if (intervals.length === 0) return [];
  
    intervals.sort((a, b) => a[0] - b[0]);
    let merged = [intervals[0]];
  
    for (let i = 1; i < intervals.length; i++) {
        let prev = merged[merged.length - 1];
        let curr = intervals[i];
      
        if (prev[1] >= curr[0]) {
            prev[1] = Math.max(prev[1], curr[1]);
        } else {
            merged.push(curr);
        }
    }
  
    return merged;
}
```

#### **D. Find Duplicate Number (Medium)**
- **Problem**: Given an array containing `n+1` integers where each integer is between `1` and `n`, find the duplicate.
- **Key Concept**: Use Floyd's Tortoise and Hare (Cycle Detection) algorithm.

```js
function findDuplicate(nums) {
    let slow = nums[0];
    let fast = nums[0];
  
    do {
        slow = nums[slow];
        fast = nums[nums[fast]];
    } while (slow !== fast);
  
    slow = nums[0];
    while (slow !== fast) {
        slow = nums[slow];
        fast = nums[fast];
    }
  
    return slow;
}
```

